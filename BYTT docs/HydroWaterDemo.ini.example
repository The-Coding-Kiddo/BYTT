; HydroWaterDemo.ini — annotated reference copy
;
; Not read by the application. The real file is next to the .exe and is rewritten by QSettings
; on every launch, which discards comments — so this exists to explain the fields somewhere
; that survives.

[Sonar]

; Where the towfish is — or, when testing, whichever machine runs SatCenter.
; Only used when Source=towfish.
TowfishIP=192.168.1.16

; This machine's own address. Detected once on first run; after that this value wins.
; Not used for connecting in playback — that always uses loopback.
PCIP=192.168.1.39

; Command channel (sonar settings, start/stop) and data channel (imagery, position).
; Vendor-specified — do not change unless told otherwise.
CmdPort=16128
DataPort=16129

; playback = replay a recorded file, no hardware needed
; towfish  = connect to real hardware, or a standalone SatCenter, at TowfishIP
;
; TowfishIP and PCIP must share the first three numbers when Source=towfish.
Source=playback
