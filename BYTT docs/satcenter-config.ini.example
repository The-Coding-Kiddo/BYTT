; SatCenter Config.ini — annotated reference copy
;
; This is NOT read by SatCenter, and it lives outside satcenter/ deliberately — that folder is
; edit-blocked (reference only during the migration), and its real Config.ini is rewritten by
; SatCenter itself, so comments placed directly in it would not survive.
;
; This file exists purely so the address fields are explained somewhere durable. See
; TESTING.md for the full walkthrough. Three placeholders appear below:
;
;   <THIS_PC>    the machine running SatCenter — your own IP in a same-machine test
;   <TOWFISH>    the real towfish/sonar hardware — 192.168.1.16 unless told otherwise
;   <THIS_APP>   the machine running HydroWaterDemo — usually the same as <THIS_PC>

[HydroSonar]
; Not us. This is SatCenter <-> the vendor's own display-and-control product ("HydroSonar" in
; the manual). Leave alone — nothing here affects our application.
CmdIP=<VENDOR_DISPLAY_SOFTWARE_PC>
CmdPort=5010
SonarIP=<VENDOR_DISPLAY_SOFTWARE_PC>
SonarPort=5012
INSDataIP=<VENDOR_DISPLAY_SOFTWARE_PC>
INSDataPort=6111

[UserSoftware]
; This is us. Must equal wherever SatCenter itself runs — HydroWaterDemo's TowfishIP has to
; match this address, or the two will never find each other.
RemoteControlIP=<THIS_PC>
RemoteControlPort=16128
DataIP=<THIS_PC>
DataPort=16129
UserRawDataNetON=1
UserRawDataIP=<THIS_PC>
UserRawDataPort=16125

[SonarDevice]
; Where SatCenter looks for the real hardware. Must be <TOWFISH>, never <THIS_PC> or
; <THIS_APP> — pointing this at either PC makes SatCenter connect to itself, which looks like
; a working connection and proves nothing.
;
; NOTE: SonarPort here should be 5002 (side-scan data), not 5012 — 5012 belongs to the
; [HydroSonar] section above. If you see 5012 in the real file, that is a bug, not a choice.
CmdIP=<TOWFISH>
CmdPort=5001
SonarIP=<TOWFISH>
SonarPort=5002
INSDataIP=<TOWFISH>
INSDataPort=6001

[UserPara]
; Sonar behaviour settings — not address fields, left as-is. FileStoreON=0 means SatCenter is
; not recording; do not expect .hsf output while it is 0.
DataUploadON=1
DataUploadType=3101
UserRawDataNetUploadType=0
ImageWidth=1024
ImageHeiht=1024
ImageBrightness=50
ImageUploadTime=1000
FileStoreON=0
INSDataTimeSynON=0
INSDataType=0
INSDataNetType=1
TimeZoneHour=8
SyncOutputPeriodSetON=0
SyncOutputPeriodValue=1000

[File]
; Where SatCenter would store recordings if FileStoreON=1. Not our concern once A5 lands —
; recording moves to our own side.
StoragePathSrc=0
DataFileSavePath=<LOCAL_STORAGE_PATH>
FileMaxSize=1024
AutoDeleteFileON=0
DiskSpaceSize=5
LimitFileSaveSpaceON=0
LimitFileSaveSpaceSize=12
FileHandON=0

[Other]
; Internal debugging feature. Leave off (0) unless told otherwise by the vendor team.
UDPMonitorNetON=0
UDPMonitorNetIP=<THIS_PC>
UDPMonitorNetPort=6002

[SerialPort]
; Confirmed dead — the manual no longer describes serial mode (INSDataNetType=3 is gone), and
; nothing on our side uses it. Leave disabled.
MasterControlComON=0
